#!/usr/bin/env bash
# PyCastle project quality gate.
#
# PyCastle runs this script inside each issue's worktree after the implement
# phase. Exit 0 means the gates passed; any non-zero exit means they failed and
# the attempt is retried with a handoff document (#8, wired through `pycastle
# run` in #14). The script is project-owned: edit it to change what "passing"
# means for this repo. `pycastle init` (#11) scaffolds a default gate matching
# this convention.
set -euo pipefail

VENV_RUFF=".venv/bin/ruff"
VENV_BLACK=".venv/bin/black"
VENV_PYTEST=".venv/bin/pytest"

ruff_cmd=$([ -x "$VENV_RUFF" ] && echo "$VENV_RUFF" || echo "ruff")
black_cmd=$([ -x "$VENV_BLACK" ] && echo "$VENV_BLACK" || echo "black")
pytest_cmd=$([ -x "$VENV_PYTEST" ] && echo "$VENV_PYTEST" || echo "pytest")

"$ruff_cmd" check . --exit-non-zero-on-fix
"$black_cmd" --check .
"$pytest_cmd" -q
